# Copy to .env for local dev. Never commit the real .env file.

SECRET_KEY=django-insecure-dev-only-change-in-prod
DEBUG=True

# Production only (Render sets DATABASE_URL automatically when Postgres is linked)
# DATABASE_URL=postgres://user:password@host:5432/dbname
# ALLOWED_HOSTS=your-backend.onrender.com
# CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app

ACCESS_TOKEN_LIFETIME_MINUTES=60
REFRESH_TOKEN_LIFETIME_DAYS=30
AUTH_THROTTLE_RATE=10/min

# Password reset — Resend SMTP relay (production only; dev prints to console)
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=SokoPrice <onboarding@resend.dev>
FRONTEND_URL=http://localhost:8081

# Demo admin account created by seed_demo_data — change this in Render's
# env vars (not here) before sharing the app with anyone real. Re-running
# the seed command (every deploy does) re-syncs the password from this.
DEMO_ADMIN_PASSWORD=sokoprice-demo-2026

# Phase 6 — price alert SMS
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
